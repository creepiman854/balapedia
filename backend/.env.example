# Configuración principal de Flask
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-in-production

# Base de datos
DATABASE_URL=mysql+pymysql://user:password@host:3306/balapedia

# URLs y seguridad (CORS)
CORS_ORIGINS=http://localhost:5173

# URLs públicas usadas por Steam OpenID y redirecciones.
# En desarrollo normal:
#   PUBLIC_BACKEND_URL=http://localhost:8080
#   PUBLIC_FRONTEND_URL=http://localhost:5173
#
# Si se prueba desde móviles u otros dispositivos de la LAN,
# sustituir localhost por la IP local del PC
# (ej: http://192.168.1.93:8080).
PUBLIC_BACKEND_URL=http://localhost:8080
PUBLIC_FRONTEND_URL=http://localhost:5173

# APIs externas y autenticación
STEAM_API_KEY=
FIREBASE_ADMIN_CREDENTIALS_PATH=./firebase-admin.json

# Identificador de la app para la MediaWiki API. Buenas prácticas:
# incluir email o URL de contacto. Si lo dejas vacío, se usa
# "BalapediaTFG/0.1" genérico (válido pero menos cortés).
WIKI_USER_AGENT=

# Servicio de correo (SMTP)
# Mailtrap SMTP (sandbox para development; emails NO llegan al destinatario real)
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=<tu-mailtrap-username>
MAIL_PASSWORD=<tu-mailtrap-password>
MAIL_DEFAULT_SENDER=noreply@balapedia.dev