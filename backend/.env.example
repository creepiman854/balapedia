# Identificador de la app para la MediaWiki API. Buenas prácticas:
# incluir email o URL de contacto. Si lo dejas vacío, se usa
# "BalapediaTFG/0.1" genérico (válido pero menos cortés).
WIKI_USER_AGENT=

FLASK_ENV=development
FLASK_SECRET_KEY=change-me-in-production
DATABASE_URL=mysql+pymysql://user:password@host:3306/balapedia
STEAM_API_KEY=
FIREBASE_ADMIN_CREDENTIALS_PATH=./firebase-admin.json
CORS_ORIGINS=http://localhost:5173

PUBLIC_BACKEND_URL=http://localhost:8080
PUBLIC_FRONTEND_URL=http://localhost:5173