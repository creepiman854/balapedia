# Configuración Firebase del SDK cliente (PUBLIC: Firebase diseña estas
# credenciales para ser visibles en el frontend; la seguridad la dan las
# Security Rules de Firebase, no la ocultación de estas claves).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# URL del backend.
# En desarrollo local usar localhost.
# Para pruebas desde dispositivos móviles en la misma red,
# usar la IP LAN del equipo que ejecuta Flask.
VITE_API_BASE_URL=http://localhost:8080